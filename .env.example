DATABASE_URL="postgresql://heimdall:heimdall@localhost:5544/heimdall"

# GitHub fine-grained token (contents:read, pull-requests:read,
# deployments:read) for drift detection: open PRs against the prod branch, and
# production's latest GitHub Deployment vs. the branch tip.
GITHUB_TOKEN=""

# DataForSEO credentials for SEO rank tracking.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Discord webhook URL for alert notifications.
DISCORD_WEBHOOK_URL=""

# ntfy push notifications for alerts. NTFY_BASE_URL must be reachable from
# Heimdall; for an ntfy server in another Docker network that is its public
# domain. NTFY_TOKEN authenticates a publisher account and can stay empty on
# servers that accept anonymous posts. NTFY_TOPIC defaults to "heimdall".
NTFY_BASE_URL=""
NTFY_TOKEN=""
NTFY_TOPIC=""

# Auth.js (Google OAuth). Create credentials at
# https://console.cloud.google.com/apis/credentials, type "Web application".
# Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (local) and
# https://<your-domain>/api/auth/callback/google (production).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Secret used by Auth.js to encrypt the session JWT.
# Generate with: npx auth secret
AUTH_SECRET=""

# Who may sign in. Set one or both:
# - ALLOWED_EMAIL_DOMAIN: every account on this Google Workspace domain,
#   checked against the verified `hd` claim on Google's ID token.
# - ALLOWED_EMAILS: comma-separated addresses, which also works for plain
#   Gmail accounts.
ALLOWED_EMAIL_DOMAIN=""
ALLOWED_EMAILS=""

# Bearer secret the /api/cron/* routes check for in the Authorization header.
# If unset, those routes are unauthenticated (fine for local dev).
CRON_SECRET=""
